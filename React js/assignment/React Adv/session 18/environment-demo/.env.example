```env
# ==========================================
# FIREBASE CONFIGURATION
# ==========================================

# Firebase Web API key.
# Used by the Firebase JavaScript SDK to connect
# your React application to your Firebase project.
# NOTE: Firebase Web API keys are normally exposed
# in client-side applications.
VITE_FIREBASE_API_KEY=your_firebase_api_key

# Firebase authentication domain.
# Used for Firebase Authentication.
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase project ID.
# Identifies your Firebase project.
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase storage bucket.
# Used when your React application uploads files
# to Firebase Storage.
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Firebase messaging sender ID.
# Used by Firebase Cloud Messaging when push
# notifications are configured.
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase application ID.
# Identifies the Firebase web application.
VITE_FIREBASE_APP_ID=your_firebase_app_id


# ==========================================
# SPOTIFY CONFIGURATION
# ==========================================

# Spotify Client ID.
# Used to identify your Spotify application when
# starting Spotify OAuth authentication.
# This is NOT a client secret.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Spotify access token.
# Only use this if your application obtains a
# short-lived token for browser-side API requests.
# Do NOT store a long-lived/private client secret here.
VITE_SPOTIFY_ACCESS_TOKEN=your_spotify_access_token


# ==========================================
# GOOGLE MAPS CONFIGURATION
# ==========================================

# Google Maps browser API key.
# Used by Google Maps JavaScript API or a React
# Google Maps library to display maps and locations.
# Restrict this key by HTTP referrers and limit the
# APIs it can access in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
```
